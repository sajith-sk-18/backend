# ~/domains/flurotech.in/laravel-api/.env
# Copy to .env on the server and fill in the MySQL values from hPanel -> Databases.

APP_NAME="Fluro Tech"
APP_ENV=production
APP_KEY=                       # php artisan key:generate  (do NOT reuse the dev key)
APP_DEBUG=false
APP_URL=https://flurotech.in/api

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

FILESYSTEM_DISK=public
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
